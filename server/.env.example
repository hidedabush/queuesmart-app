# Copy this file to server/.env and fill it in. Never commit .env.

# From the Aiven service page: Service URI.
DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/defaultdb

# Or a private MySQL on this laptop (npm run db:up, docker-compose.yml):
# DATABASE_URL=mysql://root:queuesmart@localhost:3306/queuesmart

# Any long random text. Tokens stop working if it changes.
JWT_SECRET=change-me
