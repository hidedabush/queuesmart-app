# npm run db:start copies this file to server/.env for you. Never commit .env.

# The MySQL that npm run db:start runs in Docker (docker-compose.yml).
DATABASE_URL=mysql://root:queuesmart@localhost:3306/queuesmart

# Or a MySQL you installed yourself (SETUP.md, "Manual setup"). Put your root
# password in place of YOUR_PASSWORD:
# DATABASE_URL=mysql://root:YOUR_PASSWORD@localhost:3306/queuesmart

# Any long random text. Tokens stop working if it changes.
JWT_SECRET=change-me
